{
  "paths": {
    "/users/{userId}/orders/{orderId}/payment": {
      "post": {
        "summary": "Pay for an order",
        "operationId": "payOrder",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The user's id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Api-Key",
            "in": "header",
            "required": true,
            "description": "Required credential",
            "example": "let-me-in",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "How the order is being paid for",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMethod"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "Missing or bad API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No user with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BankTransfer": {
        "type": "object",
        "properties": {
          "iban": {
            "type": "string"
          }
        },
        "required": [
          "iban"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string"
          },
          "expiry": {
            "type": "string"
          }
        },
        "required": [
          "expiry",
          "number"
        ]
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "reference"
        ]
      },
      "PaymentMethod": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Card"
          },
          {
            "$ref": "#/components/schemas/BankTransfer"
          },
          {
            "$ref": "#/components/schemas/Invoice"
          }
        ],
        "discriminator": {
          "propertyName": "method",
          "mapping": {
            "card": "#/components/schemas/Card",
            "bank_transfer": "#/components/schemas/BankTransfer",
            "invoice": "#/components/schemas/Invoice"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "paidWith": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "total": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "orderId",
          "paidWith",
          "total"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}
