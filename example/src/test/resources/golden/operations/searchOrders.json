{
  "paths": {
    "/search": {
      "get": {
        "summary": "Lens-style: the handler reads inputs from the Params bag",
        "operationId": "searchOrders",
        "tags": [
          "diagnostics"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum rows to stream",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only this status",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "SHIPPED",
                "DELIVERED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "item",
            "in": "query",
            "required": false,
            "description": "Only these items",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Only orders carrying these tags",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort keys, most significant first",
            "style": "pipeDelimited",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Return only these fields",
            "style": "spaceDelimited",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "description": "Correlation id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Feature",
            "in": "header",
            "required": false,
            "description": "Feature flags the caller has on",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "seen",
            "in": "cookie",
            "required": false,
            "description": "Orders this browser has already been shown",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A newline-delimited JSON stream. Chunked; consume incrementally.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "A refusal: this request was not answered by the operation above.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "item": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "id",
          "item",
          "quantity",
          "status",
          "userId"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "error",
          "status"
        ]
      }
    }
  }
}
