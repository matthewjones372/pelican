{
  "paths": {
    "/users/{userId}/orders/watch": {
      "get": {
        "summary": "Live order events over server-sent events",
        "operationId": "watchOrders",
        "tags": [
          "orders"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The user's id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum rows to stream",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A server-sent event stream.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Tick"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tick": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int32"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "seq"
        ]
      }
    }
  }
}
