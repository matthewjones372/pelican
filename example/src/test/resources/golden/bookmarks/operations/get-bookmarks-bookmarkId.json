{
  "paths": {
    "/bookmarks/{bookmarkId}": {
      "get": {
        "summary": "Fetch one bookmark",
        "operationId": "getBookmarksByBookmarkId",
        "tags": [
          "bookmarks"
        ],
        "parameters": [
          {
            "name": "bookmarkId",
            "in": "path",
            "required": true,
            "description": "The bookmark's id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            }
          },
          "404": {
            "description": "No bookmark with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoSuchBookmark"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bookmark": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "url"
        ]
      },
      "NoSuchBookmark": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "message"
        ]
      }
    }
  }
}
