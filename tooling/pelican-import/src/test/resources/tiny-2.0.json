{
  "swagger": "2.0",
  "info": { "title": "Tiny", "version": "1.0.0" },
  "host": "tiny.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "security": [{ "apiKey": [] }],
  "securityDefinitions": {
    "apiKey": { "type": "apiKey", "in": "header", "name": "X-Api-Key" }
  },
  "definitions": {
    "Widget": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "Problem": {
      "type": "object",
      "required": ["detail"],
      "properties": { "detail": { "type": "string" } }
    }
  },
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "summary": "List widgets",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "type": "integer", "format": "int32", "minimum": 1 }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Widget" } }
          }
        }
      },
      "post": {
        "operationId": "createWidget",
        "summary": "Create a widget",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/Widget" } }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Widget" } },
          "404": { "description": "Nope", "schema": { "$ref": "#/definitions/Problem" } }
        }
      }
    }
  }
}
